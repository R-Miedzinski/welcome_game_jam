; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Gnomo-Destruktor"
config/description="Jesteś szeregowym pracownikiem znanej firmy zajmującej się niszczeniem środowisk naturalnych pod inwestycje korporacyjne.
Twoje zadanie?
Obrona twojej ukochanej firmy przed paskudnymi potworami z lasu, które tylko czekają, aby zniszczyć cywilizację ludzką
Do dyspozycji masz wyprodukowane przez twojego pracodawcę chemikalia, mieszając je i rzucając w paskudne kreatury możesz je wysłać z powrotem do lasu, z którego przybyły.
Efekty mieszaj dowolnie, zobacz jaka mikstura będzie zabijać gnomy najskuteczniej!


Firma XXXXX nie jest odpowiedzialna za użycie tworzonych przez nią środków chemiczny w sposób niewskazany na opakowaniu, w przypadku wystąpienia objawów takich jak: ból głowy, osłabienie, wymioty, biegunka, palpitacje serca, myśli xxxxxxxxxx czy łysienie należy niezwłocznie skontaktować się z lekarzem."
run/main_scene="uid://pdaaoidt2yye"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="uid://bkjor2pmnd24u"
config/windows_native_icon="res://icon.ico"

