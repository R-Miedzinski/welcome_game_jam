	float n_out11p1 = n_out8p0.y;
	float n_out11p2 = n_out8p0.z;
	float n_out11p3 = n_out8p0.w;


// FloatOp:12
	float n_in12p1 = 5.75500;
	float n_out12p0 = n_out11p0 / n_in12p1;


// Texture2D:16
	vec4 n_out16p0 = texture(tex_frg_16, UV);


// VectorDecompose:18
	float n_out18p0 = n_out16p0.x;
	float n_out18p1 = n_out16p0.y;
	float n_out18p2 = n_out16p0.z;
	float n_out18p3 = n_out16p0.w;


// FloatOp:17
	float n_out17p0 = n_out12p0 * n_out18p0;


// VectorOp:10
	vec2 n_out10p0 = n_out9p0 + vec2(n_out17p0);


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out10p0);


// VectorOp:6
	vec4 n_out6p0 = n_out4p0 * n_out2p0;


// VectorDecompose:7
	float n_out7p0 = n_out2p0.x;
	float n_out7p1 = n_out2p0.y;
	float n_out7p2 = n_out2p0.z;
	float n_out7p3 = n_out2p0.w;


// Output:0
	ALBEDO = vec3(n_out6p0.xyz);
	ALPHA = n_out7p0;


}
