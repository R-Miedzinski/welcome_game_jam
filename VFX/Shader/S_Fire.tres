// VectorOp:15
	vec2 n_in15p1 = vec2(0.00000, 1.00000);
	vec2 n_out15p0 = vec2(n_out14p0) * n_in15p1;


// UVFunc:13
	vec2 n_in13p1 = vec2(1.00000, 1.00000);
	vec2 n_out13p0 = n_out15p0 * n_in13p1 + UV;


// Texture2D:8
	vec4 n_out8p0 = texture(tex_frg_8, n_out13p0);


// VectorDecompose:11
